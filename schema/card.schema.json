{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/local/miljokart/schema/card.schema.json",
  "title": "Miljokart card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "type",
    "name",
    "state",
    "updated",
    "summary",
    "claims",
    "links",
    "geometry",
    "map_features",
    "checked_empty",
    "open_questions"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "type": {
      "enum": ["problem", "organization", "lobbying_firm", "lawmaker", "bill"]
    },
    "name": { "type": "string", "minLength": 1 },
    "state": { "const": "CA" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "rank": { "type": ["integer", "null"], "minimum": 1, "maximum": 10 },
    "org_kind": {
      "type": ["string", "null"],
      "enum": ["company", "trade_association", "regulator", "utility", "water_district", null]
    },
    "summary": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/claim" }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rel", "target_id", "text"],
        "properties": {
          "rel": {
            "enum": [
              "problem",
              "organization",
              "lobbying_firm",
              "lawmaker",
              "bill",
              "regulator"
            ]
          },
          "target_id": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "geometry": { "$ref": "#/$defs/geometryOrNull" },
    "map_features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "name", "geometry"],
        "properties": {
          "layer": { "enum": ["problem", "facility", "tract"] },
          "name": { "type": "string" },
          "geometry": { "$ref": "#/$defs/geometry" }
        }
      }
    },
    "checked_empty": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "searched", "result", "urls", "retrieved"],
        "properties": {
          "field": { "type": "string" },
          "searched": { "type": "string", "minLength": 8 },
          "result": { "enum": ["not_found", "not_verified"] },
          "urls": { "type": "array", "items": { "type": "string" } },
          "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "publisher", "retrieved", "archive_url", "archive_note"],
      "properties": {
        "url": { "type": "string", "minLength": 8 },
        "title": { "type": "string" },
        "publisher": { "type": "string" },
        "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "archive_url": { "type": "string" },
        "archive_note": { "type": "string" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "status", "note", "sources"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "status": { "enum": ["confirmed", "indication", "not_found", "not_verified"] },
        "note": { "type": "string" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates",
        "source_name",
        "source_record_id",
        "source_url",
        "retrieved",
        "note"
      ],
      "properties": {
        "type": { "enum": ["Point", "Polygon", "MultiPolygon"] },
        "coordinates": {},
        "source_name": { "type": "string", "minLength": 2 },
        "source_record_id": { "type": "string", "minLength": 2 },
        "source_url": { "type": "string", "minLength": 8 },
        "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "type": "string", "minLength": 8 }
      }
    },
    "geometryOrNull": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/geometry" }]
    }
  }
}

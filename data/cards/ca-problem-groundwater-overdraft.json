{
  "id": "ca-problem-groundwater-overdraft",
  "type": "problem",
  "name": "Kritisk overtrukket grunnvann",
  "rank": 10,
  "summary": [
    {
      "id": "s1",
      "text": "DWR skriver at SGMA pålegger etaten å peke ut basseng i critical overdraft, definert som at fortsatt bruk sannsynligvis gir betydelige negative miljø-, samfunns- eller økonomiske virkninger. Overdraft er når uttaket over tid er større enn tilførselen.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://water.ca.gov/programs/groundwater-management/bulletin-118/critically-overdrafted-basins",
          "title": "Critically Overdrafted Basins",
          "publisher": "California Department of Water Resources",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260918115628/https://water.ca.gov/programs/groundwater-management/bulletin-118/critically-overdrafted-basins",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s2",
      "text": "DWRs kart fra januar 2020, basert på Bulletin 118-grenser publisert 11. februar 2019, lister 21 basseng og delbasseng. Elleve av dem ligger i San Joaquin Valley, fra Eastern San Joaquin 5-022.01 til Kern County 5-022.14.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://water.ca.gov/-/media/DWR-Website/Web-Pages/Programs/Groundwater-Management/Bulletin-118/Critically-Overdrafted-Basins/Files/COD-Basins.pdf",
          "title": "California's Critically Overdrafted Groundwater Basins",
          "publisher": "California Department of Water Resources",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250630230548/https://water.ca.gov/-/media/DWR-Website/Web-Pages/Programs/Groundwater-Management/Bulletin-118/Critically-Overdrafted-Basins/Files/COD-Basins.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s3",
      "text": "DWR skriver at virkninger kan være saltvannsinntrenging, setninger, utarming av grunnvann og vedvarende senkning av grunnvannsnivået.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://water.ca.gov/programs/groundwater-management/bulletin-118/critically-overdrafted-basins",
          "title": "Critically Overdrafted Basins",
          "publisher": "California Department of Water Resources",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260918115628/https://water.ca.gov/programs/groundwater-management/bulletin-118/critically-overdrafted-basins",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s4",
      "text": "Census tract 6029006201 i Kern County har drikkevannsindikator 1 022,63 og persentil 99,63, og pesticidindikator 4 226,06. Det er en illustrasjon i fylket, ikke bassengets grense.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://services1.arcgis.com/PCHfdHz4GlDNAhBb/arcgis/rest/services/CalEnviroScreen_4_0_Results_/FeatureServer/0/query?where=tract%3D6019001100&outFields=tract,CIscore,CIscoreP,ACS2019TotalPop,pm,drink,pest&returnGeometry=true&outSR=4326&f=geojson",
          "title": "CalEnviroScreen 4.0 FeatureServer, utvalgte trakter",
          "publisher": "OEHHA",
          "retrieved": "2026-10-28",
          "archive_url": "https://web.archive.org/web/20261028154034/https://services1.arcgis.com/PCHfdHz4GlDNAhBb/arcgis/rest/services/CalEnviroScreen_4_0_Results_/FeatureServer/0/query?where=tract%3D6019001100&outFields=tract,CIscore,CIscoreP,ACS2019TotalPop,pm,drink,pest&returnGeometry=true&outSR=4326&f=geojson",
          "archive_note": "Save Page Now 2026-10-28 opprettet et øyeblikksbilde."
        }
      ]
    }
  ],
  "claims": [
    {
      "id": "c1",
      "text": "De elleve San Joaquin Valley-numrene på kartet er 5-022.01, 5-022.04, 5-022.05, 5-022.06, 5-022.07, 5-022.08, 5-022.09, 5-022.11, 5-022.12, 5-022.13 og 5-022.14.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://water.ca.gov/-/media/DWR-Website/Web-Pages/Programs/Groundwater-Management/Bulletin-118/Critically-Overdrafted-Basins/Files/COD-Basins.pdf",
          "title": "California's Critically Overdrafted Groundwater Basins",
          "publisher": "California Department of Water Resources",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250630230548/https://water.ca.gov/-/media/DWR-Website/Web-Pages/Programs/Groundwater-Management/Bulletin-118/Critically-Overdrafted-Basins/Files/COD-Basins.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "c2",
      "text": "Problemet rangeres sist av de ti fordi DWR dokumenterer en ressurs- og setningsrisiko, ikke et antall mennesker som drikker vann over en grenseverdi. Det tallet ligger på drikkevannskortet.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://water.ca.gov/programs/groundwater-management/bulletin-118/critically-overdrafted-basins",
          "title": "Critically Overdrafted Basins",
          "publisher": "California Department of Water Resources",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260918115628/https://water.ca.gov/programs/groundwater-management/bulletin-118/critically-overdrafted-basins",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."

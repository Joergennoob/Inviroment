  "summary": [
    {
      "id": "s1",
      "text": "Henry Stern er demokrat. Han er senator for et område i Los Angeles og Ventura, der gasslageret Aliso Canyon ligger. Håndboken sier at han har sittet siden desember 2016.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.senate.ca.gov/system/files/2026-09/joint_handbook_2025-26_web_1.pdf",
          "title": "California Legislature Handbook 2025-26",
          "publisher": "California State Senate",
          "retrieved": "2026-10-28",
          "archive_url": "",
          "archive_note": "PDF-en er lest 2026-10-28. Wayback er ikke slått opp."
        }
      ]
    },
    {
      "id": "s2",
      "text": "I desember 2024 sa han at gasslageret bør stenges, og at en plan om å bruke det til 2039 er feil.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://sd27.senate.ca.gov/news/sen-stern-asm-schiavo-look-expedite-closure-aliso-canyon-discounts-energy-upgrades-san",
          "title": "Stern og Schiavo om Aliso Canyon",
          "publisher": "Kontoret til Henry Stern",
          "retrieved": "2026-10-28",
          "archive_url": "",
          "archive_note": "Siden er lest 2026-10-28."
        }
      ]
    },
    {
      "id": "s3",
      "text": "I 2022 falt et forslag han hadde lagt fram, med 5 ja og 12 nei. Hans eget navn står på nei-listen. Vi har ikke et referat som forklarer hvorfor.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=202120220SB1486",
          "title": "Stemmeliste sb1486",
          "publisher": "California Legislative Counsel",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250918170037/https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=202120220SB1486",
          "archive_note": "Leginfo svarte 403 direkte. Listen er lest i arkivet."
        }
      ]
    },
    {
      "id": "s4",
      "text": "Året etter stemte han ja til et fond etter lekkasjen. Hele senatet stemte ja.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=202320240SB305",
          "title": "Stemmeliste sb305",
          "publisher": "California Legislative Counsel",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260118213538/https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=202320240SB305",
          "archive_note": "Leginfo svarte 403 direkte. Listen er lest i arkivet."
        }
      ]
    }
  ],

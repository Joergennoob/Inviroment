    {
      "id": "s1",
      "text": "Joaquin Arambula er demokrat. Han sitter i forsamlingen for deler av Fresno. Håndboken sier at han har sittet siden april 2016.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.senate.ca.gov/system/files/2026-09/joint_handbook_2025-26_web_1.pdf",
          "title": "California Legislature Handbook 2025-26",
          "publisher": "California State Senate",
          "retrieved": "2026-10-28",
          "archive_url": "",
          "archive_note": "PDF-en er lest 2026-10-28. Wayback er ikke slått opp."
        }
      ]
    },
    {
      "id": "s2",
      "text": "Han stemte ja til loven som gir lokalsamfunn mer å si om skitten luft.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=201720180AB617",
          "title": "Stemmeliste ab617",
          "publisher": "California Legislative Counsel",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250531134318/https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=201720180AB617",
          "archive_note": "Leginfo svarte 403 direkte. Listen er lest i arkivet."
        }
      ]
    },
    {
      "id": "s3",
      "text": "På den endelige avstemningen om måling ved raffinerigjerdet stemte han ikke.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=201720180AB1647",
          "title": "Stemmeliste ab1647",
          "publisher": "California Legislative Counsel",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250919093406/https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=201720180AB1647",
          "archive_note": "Leginfo svarte 403 direkte. Listen er lest i arkivet."
        }
      ]
    },
    {
      "id": "s4",
      "text": "På oljeloven i 2022 stemte han ikke.",
      "status": "confirmed",
      "note": "",

  "summary": [
    {
      "id": "s1",
      "text": "Caroline Menjivar er demokrat. Hun er senator for Burbank og San Fernando-dalen i Los Angeles. Håndboken sier at hun har sittet siden desember 2022.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.senate.ca.gov/system/files/2026-09/joint_handbook_2025-26_web_1.pdf",
          "title": "California Legislature Handbook 2025-26",
          "publisher": "California State Senate",
          "retrieved": "2026-10-28",
          "archive_url": "",
          "archive_note": "PDF-en er lest 2026-10-28. Wayback er ikke slått opp."
        }
      ]
    },
    {
      "id": "s2",
      "text": "Hun stemte ja til å varsle skoler når det sprøytes i nærheten.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=202320240AB1864",
          "title": "Stemmeliste ab1864",
          "publisher": "California Legislative Counsel",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260117220802/https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=202320240AB1864",
          "archive_note": "Leginfo svarte 403 direkte. Listen er lest i arkivet."
        }
      ]
    },
    {
      "id": "s3",
      "text": "På loven om lager av drivstoff stemte hun ikke.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=202320242AB1",
          "title": "Stemmeliste abx2",
          "publisher": "California Legislative Counsel",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260308020621/https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=202320242AB1",
          "archive_note": "Leginfo svarte 403 direkte. Listen er lest i arkivet."
        }
      ]
    },
    {
      "id": "s4",
      "text": "Hun stemte ja til å la lokalsamfunn si mer om oljeboring.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=202320240AB3233",

  "claims": [
    {
      "id": "c1",
      "text": "Cal-Access-fileren «Sempra and its affiliates: San Diego Gas & Electric Company and Southern California Gas Company», id 1146926, har 3 347 511,14 dollar i lobbybetalinger i sesjonen 2025-2026. Beløpet er ikke spesifisert til Aliso Canyon.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://dbsearch.sos.ca.gov/LobbyIntSearch.aspx",
          "title": "Cal-Access Lobbyist Employer Category Search, sesjon 2025-2026, database oppdatert 28-OCT-2026 08:15:07",
          "publisher": "California Secretary of State",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250525150615/https://dbsearch.sos.ca.gov/LobbyIntSearch.aspx",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "c2",
      "text": "Problemet rangeres her fordi utslippet er stort og dokumentert, men det er ett anlegg og den akutte lekkasjen skjedde i 2015-2016. Et folketall for evakuerte er ikke hentet fra en primærkilde.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://ww2.arb.ca.gov/sites/default/files/2020-07/aliso_canyon_methane_emissions-arb_final.pdf",
          "title": "Determination of Total Methane Emissions from the Aliso Canyon Natural Gas Leak Incident, 21. oktober 2016",
          "publisher": "California Air Resources Board",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250929083350/https://ww2.arb.ca.gov/sites/default/files/2020-07/aliso_canyon_methane_emissions-arb_final.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "r2-aliso-cpuc",
      "text": "CPUC-vedtak D.24-12-076 setter største arbeidsvolum for gass i Aliso Canyon til 68,6 milliarder kubikkfot og lar anlegget fortsette, med vurdering annethvert år. Et vedtak som avslår gjenopptakelse, gjentar dette nivået. Energidivisjonens vurdering i 2025 anbefaler et kutt på 10 milliarder kubikkfot til 58,6. Den anbefalingen er ikke et nytt vedtak. SoCalGas har bedt kommisjonen avslå kuttet i sak A.26-01-009.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://docs.cpuc.ca.gov/PublishedDocs/Published/G000/M569/K577/569577353.PDF",
          "title": "Order denying rehearing of D.24-12-076",
          "publisher": "CPUC",
          "retrieved": "2026-10-28",
          "archive_url": "",
          "archive_note": "Wayback availability 2026-10-28 fant ikke et øyeblikksbilde. Save Page Now ble ikke kjørt på nytt etter at tidligere kall tidsavbrøt."
        },
        {
          "url": "https://www.cpuc.ca.gov/-/media/cpuc-website/divisions/energy-division/documents/natural-gas/aliso-canyon/2025_aliso_canyon_biennial_assessment.pdf",
          "title": "2025 Aliso Canyon biennial assessment",
          "publisher": "CPUC Energy Division",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20251119104804/https://www.cpuc.ca.gov/-/media/cpuc-website/divisions/energy-division/documents/natural-gas/aliso-canyon/2025_aliso_canyon_biennial_assessment.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        },
        {
          "url": "https://docs.cpuc.ca.gov/PublishedDocs/Efile/G000/M595/K083/595083702.PDF",
          "title": "SoCalGas application on the 2025 assessment",
          "publisher": "CPUC docket",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260120220653/https://docs.cpuc.ca.gov/PublishedDocs/Efile/G000/M595/K083/595083702.PDF",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "r3-aliso-scope",
      "text": "Assigned Commissioner's Scoping Memo i A.26-01-009, datert 8. juli 2026, setter saken til om lageret skal bli på dagens kapasitet eller settes ned. Søknaden om å øke lageret er holdt utenfor saken. Et vedtak som endrer 68,6 milliarder kubikkfot i D.24-12-076, er ikke funnet.",
      "status": "confirmed",
      "note": "Notatet siterer anbefalingen om 58,6 milliarder kubikkfot. Det vedtar ikke kuttet. Tidsplanen har statuskonferanse 28. oktober 2026.",
      "sources": [
        {
          "url": "https://docs.cpuc.ca.gov/PublishedDocs/Efile/G000/M610/K355/610355447.PDF",
          "title": "Assigned Commissioner's Scoping Memo and Ruling, A.26-01-009, July 8, 2026",
          "publisher": "California Public Utilities Commission",
          "retrieved": "2026-10-28",
          "archive_url": "",
          "archive_note": "Wayback availability 2026-10-28 fant ikke et øyeblikksbilde. Save Page Now ble ikke kjørt på nytt etter at tidligere kall tidsavbrøt."
        }
      ]
    },
    {
      "id": "s1",
      "text": "CARB anslo at lekkasjen ved SoCalGas sitt Aliso Canyon-lager slapp ut 99 650 tonn metan, med usikkerhet 9 300 tonn. For full klimakompensasjon brukes øvre grense, 109 000 tonn.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://ww2.arb.ca.gov/sites/default/files/2020-07/aliso_canyon_methane_emissions-arb_final.pdf",
          "title": "Determination of Total Methane Emissions from the Aliso Canyon Natural Gas Leak Incident, 21. oktober 2016",
          "publisher": "California Air Resources Board",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250929083350/https://ww2.arb.ca.gov/sites/default/files/2020-07/aliso_canyon_methane_emissions-arb_final.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s2",
      "text": "Lekkasjen ble rapportert 23. oktober 2015 og kontrollert 11. februar 2016. CARB kaller den den største dokumenterte metanlekkasjen i USA i rapporten, med henvisning til Conley med flere i Science.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://ww2.arb.ca.gov/sites/default/files/2020-07/aliso_canyon_methane_emissions-arb_final.pdf",
          "title": "Determination of Total Methane Emissions from the Aliso Canyon Natural Gas Leak Incident, 21. oktober 2016",
          "publisher": "California Air Resources Board",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250929083350/https://ww2.arb.ca.gov/sites/default/files/2020-07/aliso_canyon_methane_emissions-arb_final.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s3",
      "text": "CARB skriver i nyhetsmeldingen at 109 000 tonn omtrent tilsvarer et års gassbruk i 190 000 boliger i Los Angeles. Det er en sammenligning, ikke et folketall for Porter Ranch.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://ww2.arb.ca.gov/news/aliso-canyon-leak-emitted-109000-metric-tons-methane",
          "title": "Aliso Canyon leak emitted 109,000 metric tons of methane",
          "publisher": "California Air Resources Board",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20261016014955/https://ww2.arb.ca.gov/news/aliso-canyon-leak-emitted-109000-metric-tons-methane",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },

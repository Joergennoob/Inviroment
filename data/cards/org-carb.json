  "name": "California Air Resources Board",
  "summary": [
    {
      "id": "plain-1",
      "text": "Dette er Californias lufttilsyn. De har ansvar for utslipp fra biler og lastebiler. De lokale luftkontorene tar fabrikker og andre faste anlegg.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.federalregister.gov/documents/2026/06/11/2026-11735/attainment-date-extension-for-the-san-joaquin-valley-california-2012-annual-pm25-fine-particulate",
          "title": "Attainment Date Extension for the San Joaquin Valley 2012 Annual PM2.5 Area",
          "publisher": "US EPA",
          "retrieved": "2026-10-28",
          "archive_url": "https://web.archive.org/web/20261028134815/https://unblock.federalregister.gov/",
          "archive_note": "Save Page Now 2026-10-28 opprettet et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "plain-2",
      "text": "De regnet ut at gasslekkasjen ved Aliso Canyon var om lag 100 000 tonn metan. Metan er hovedstoffet i naturgass.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://ww2.arb.ca.gov/sites/default/files/2020-07/aliso_canyon_methane_emissions-arb_final.pdf",
          "title": "Determination of Total Methane Emissions from the Aliso Canyon Natural Gas Leak Incident, 21. oktober 2016",
          "publisher": "California Air Resources Board",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250929083350/https://ww2.arb.ca.gov/sites/default/files/2020-07/aliso_canyon_methane_emissions-arb_final.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "plain-3",
      "text": "De har også ansvar for en lov om ekstra oppfølging av lufta i nabolag med mye forurensning.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billTextClient.xhtml?bill_id=201720180AB617",
          "title": "AB 617, Chapter 136, Statutes of 2017",
          "publisher": "California Legislative Counsel",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260925233740/https://leginfo.legislature.ca.gov/faces/billTextClient.xhtml?bill_id=201720180AB617",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    }
  ],
  "claims": [
    {
      "id": "org-carb-c1",
      "text": "EPA skriver at CARB vurderer mobile kilder i San Joaquin Valley, og at CARB vedtok 2024 PM2.5-planen 25. juli 2024.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.federalregister.gov/documents/2026/06/11/2026-11735/attainment-date-extension-for-the-san-joaquin-valley-california-2012-annual-pm25-fine-particulate",

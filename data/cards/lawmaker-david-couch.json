    {
      "id": "s1",
      "text": "David Couch er fylkesstyrer i Kern. Luftstyret i San Joaquin-dalen fører ham slik på møtet 19. februar 2026.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.valleyair.org/media/dcpjbqgg/gb-21926-minutes.pdf",
          "title": "Referat, San Joaquin Valley APCD, 19. februar 2026",
          "publisher": "San Joaquin Valley APCD",
          "retrieved": "2026-10-28",
          "archive_url": "",
          "archive_note": "Wayback fant ikke PDF-en. Den er lest 28. oktober 2026."
        }
      ]
    },
    {
      "id": "s2",
      "text": "Han stemte ja til en pakke med rutinesaker: referat, møteplan, budsjettstatus og to laboratorieavtaler uten nye penger.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.valleyair.org/media/dcpjbqgg/gb-21926-minutes.pdf",
          "title": "Samtykkeliste sak 13-20",
          "publisher": "San Joaquin Valley APCD",
          "retrieved": "2026-10-28",
          "archive_url": "",
          "archive_note": "PDF lest 28. oktober 2026."
        }
      ]
    },
    {
      "id": "s3",
      "text": "Ingen på møtet stemte nei til den pakken. Det var ikke en avstemning om en ny utslippsregel.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.valleyair.org/media/dcpjbqgg/gb-21926-minutes.pdf",
          "title": "Referat, votering",
          "publisher": "San Joaquin Valley APCD",
          "retrieved": "2026-10-28",
          "archive_url": "",
          "archive_note": "PDF lest 28. oktober 2026."
        }
      ]
    }
  ],
  "claims": [

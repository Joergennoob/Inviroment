  "name": "Shannon Grove",
  "state": "CA",
  "updated": "2026-10-28",
  "rank": null,
  "org_kind": null,
  "summary": [
    {
      "id": "s1",
      "text": "Shannon Grove er republikaner. Hun er senator for et område med deler av Fresno, Kern og Tulare. Hun satt i forsamlingen fra desember 2010 til 2016, og i senatet fra desember 2018.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.senate.ca.gov/system/files/2026-09/joint_handbook_2025-26_web_1.pdf",
          "title": "California Legislature Handbook 2025-26",
          "publisher": "California State Senate",
          "retrieved": "2026-10-28",
          "archive_url": "",
          "archive_note": "PDF-en er lest 2026-10-28. Wayback er ikke slått opp."
        }
      ]
    },
    {
      "id": "s2",
      "text": "Da senatet vedtok loven om avstand mellom oljebrønner og hus, stemte hun nei. Det var 25 ja og 10 nei.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=202120220SB1137",
          "title": "Stemmeliste sb1137",
          "publisher": "California Legislative Counsel",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250920054954/https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=202120220SB1137",
          "archive_note": "Leginfo svarte 403 direkte. Listen er lest i arkivet."
        }
      ]
    },
    {
      "id": "s3",
      "text": "Dagen loven ble signert, skrev kontoret hennes at loven ville stanse mange brønner.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://sr12.senate.ca.gov/content/senator-grove-reacts-signing-senate-bill-1137",
          "title": "Grove om signeringen av SB 1137",
          "publisher": "Kontoret til Shannon Grove",
          "retrieved": "2026-10-28",
          "archive_url": "",
          "archive_note": "Siden er lest 2026-10-28."
        }
      ]
    },
    {
      "id": "s4",
      "text": "Ni dager før nei-stemmen ga oljeselskapet California Resources 4 900 dollar til valgkampen hennes. Det viser rekkefølgen. Det viser ikke at pengene styrte stemmen.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://campaignfinance.cdn.sos.ca.gov/dbwebexport.zip",
          "title": "CAL-ACCESS LCCM_CD, uttrekk 28. oktober 2026",
          "publisher": "California Secretary of State",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260930110449/https://campaignfinance.cdn.sos.ca.gov/dbwebexport.zip",
          "archive_note": "Gaven er en rad i tabellen, koblet til giveren via regnskapsforsiden."
        },
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=202120220SB1137",
          "title": "Stemmeliste sb1137",
          "publisher": "California Legislative Counsel",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250920054954/https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=202120220SB1137",
          "archive_note": "Leginfo svarte 403 direkte. Listen er lest i arkivet."
        }
      ]
    },
    {
      "id": "s5",
      "text": "I 2014 stemte etternavnet Grove nei til de tre lovene om grunnvann. Fornavnet står ikke på listen. Håndboken sier at hun satt i forsamlingen da.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=201320140SB1168",
          "title": "Stemmeliste sb1168",
          "publisher": "California Legislative Counsel",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250314163210/https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=201320140SB1168",
          "archive_note": "Leginfo svarte 403 direkte. Listen er lest i arkivet."
        },
        {
          "url": "https://www.senate.ca.gov/system/files/2026-09/joint_handbook_2025-26_web_1.pdf",
          "title": "California Legislature Handbook 2025-26",
          "publisher": "California State Senate",
          "retrieved": "2026-10-28",
          "archive_url": "",
          "archive_note": "PDF-en er lest 2026-10-28. Wayback er ikke slått opp."
        }
      ]
    }
  ],
  "claims": [

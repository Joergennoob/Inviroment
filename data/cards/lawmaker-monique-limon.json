  "rank": null,
  "org_kind": null,
  "summary": [
    {
      "id": "s1",
      "text": "Monique Limón er demokrat. Hun er senator for et område med San Luis Obispo, Santa Barbara og Ventura. Håndboken fører henne som senator for distrikt 21.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.senate.ca.gov/system/files/2026-09/joint_handbook_2025-26_web_1.pdf",
          "title": "California Legislature Handbook 2025-26",
          "publisher": "California State Senate",
          "retrieved": "2026-10-28",
          "archive_url": "",
          "archive_note": "PDF-en er lest 2026-10-28. Wayback er ikke slått opp."
        }
      ]
    },
    {
      "id": "s2",
      "text": "Hun stemte ja til loven om avstand mellom oljebrønner og hus.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=202120220SB1137",
          "title": "Stemmeliste sb1137",
          "publisher": "California Legislative Counsel",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250920054954/https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=202120220SB1137",
          "archive_note": "Leginfo svarte 403 direkte. Listen er lest i arkivet."
        }
      ]
    },
    {
      "id": "s3",
      "text": "Dagen loven ble signert, sa hun at hun var stolt av å ha stått sammen med Lena Gonzalez. Sitatet står på Gonzalez sin side.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://sd33.senate.ca.gov/news/senator-gonzalez-and-senator-limons-historic-bill-end-neighborhood-oil-and-gas-drilling-signed",
          "title": "Signering av SB 1137, sitat fra Limón",
          "publisher": "Kontoret til Lena Gonzalez",
          "retrieved": "2026-10-28",
          "archive_url": "",
          "archive_note": "Siden er lest 2026-10-28."
        }
      ]
    },
    {
      "id": "s4",
      "text": "Hun stemte også ja til varsling når det sprøytes nær skoler.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=202320240AB1864",
          "title": "Stemmeliste ab1864",
          "publisher": "California Legislative Counsel",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260117220802/https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=202320240AB1864",
          "archive_note": "Leginfo svarte 403 direkte. Listen er lest i arkivet."
        }
      ]
    }
  ],
  "claims": [
    {
      "id": "c1",
      "text": "Tallene og datoene står i stemmelisten og i håndboken. Sammendraget over er de samme faktaene med vanlige ord.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {

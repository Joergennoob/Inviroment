{
  "id": "ca-problem-pesticides",
  "type": "problem",
  "name": "Plantevernmidler i jordbruksfylker",
  "rank": 5,
  "summary": [
    {
      "id": "s1",
      "text": "DPR rapporterer at det i 2022 ble brukt 181 millioner pund aktive stoffer i California, og at 92 millioner acre ble behandlet. Begge tallene var lavere enn i 2021.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.cdpr.ca.gov/wp-content/uploads/2024/12/pur_2022_data_summary.pdf",
          "title": "Pesticide Use Annual Report 2022 Data Summary",
          "publisher": "California Department of Pesticide Regulation",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250928034349/https://www.cdpr.ca.gov/wp-content/uploads/2024/12/pur_2022_data_summary.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s2",
      "text": "Fylkestallene for 2022 viser 26 468 541 pund i Fresno, 25 835 076 pund i Kern og 17 537 932 pund i Tulare. Monterey hadde 9 187 117 pund.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.cdpr.ca.gov/wp-content/uploads/2024/12/2022_county_total_pounds_applied_agricultural_applications_and_acres_treated.pdf",
          "title": "Total Pounds, Applications, and Acres Treated by County, 2022",
          "publisher": "California Department of Pesticide Regulation",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250807002358/https://www.cdpr.ca.gov/wp-content/uploads/2024/12/2022_county_total_pounds_applied_agricultural_applications_and_acres_treated.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s3",
      "text": "DPR grupperer blant annet kreftfremkallende stoffer, fumiganter, grunnvannsforurensere og giftige luftforurensere som egne brukskategorier, og publiserer endring fra 2021 til 2022 for hver kategori.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.cdpr.ca.gov/wp-content/uploads/2024/12/pur_2022_data_summary.pdf",
          "title": "Pesticide Use Annual Report 2022 Data Summary",
          "publisher": "California Department of Pesticide Regulation",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250928034349/https://www.cdpr.ca.gov/wp-content/uploads/2024/12/pur_2022_data_summary.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s4",
      "text": "Census tract 6019001000 i Fresno County har pesticidindikator 1 321,97 og persentil 90,83 i CalEnviroScreen 4.0, og 4 255 innbyggere i ACS 2015-2019.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {

  "claims": [
    {
      "id": "c1",
      "text": "California Farm Bureau Federation, filer 1146790, har 1 436 711,70 dollar i lobbybetalinger i sesjonen 2025-2026 ifølge Cal-Access per 28. oktober 2026. Western Growers, filer 1146857, har 1 196 763,69 dollar. Corteva Agriscience LLC, filer 1146862, har 141 149,88 dollar.",
      "status": "confirmed",
      "note": "Tallene er lobbybetalinger, ikke pund sprøytet middel.",
      "sources": [
        {
          "url": "https://dbsearch.sos.ca.gov/LobbyIntSearch.aspx",
          "title": "Cal-Access Lobbyist Employer Category Search, sesjon 2025-2026, database oppdatert 28-OCT-2026 08:15:07",
          "publisher": "California Secretary of State",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250525150615/https://dbsearch.sos.ca.gov/LobbyIntSearch.aspx",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "c2",
      "text": "I bidragsregisteret, samme datofilter, er den største enkeltstrengen for Farm Bureau «CALIFORNIA FARM BUREAU FEDERATION FUND TO PROTECT THE FAMILY FARM (FARM PAC), SACRAMENTO, CA 95833» med 116 700,00 dollar. Søket ga 11 navnestrenger. De er ikke summert, fordi like organisasjoner kan være splittet på flere strenger.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://dbsearch.sos.ca.gov/ContributorSearch.aspx",
          "title": "Cal-Access Contributor Search, 01/01/2025-10/28/2026, California, database oppdatert 28-OCT-2026 08:15:07",
          "publisher": "California Secretary of State",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250808161221/https://dbsearch.sos.ca.gov/ContributorSearch.aspx",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "c3",
      "text": "Problemet rangeres etter de fire der en etat har telt mennesker under en brutt standard eller der lovgiver har vedtatt en helsesone. Pundtallene er store, men DPR-sammendraget som er lest, oppgir ikke hvor mange mennesker som ble eksponert.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.cdpr.ca.gov/wp-content/uploads/2024/12/pur_2022_data_summary.pdf",
          "title": "Pesticide Use Annual Report 2022 Data Summary",
          "publisher": "California Department of Pesticide Regulation",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250928034349/https://www.cdpr.ca.gov/wp-content/uploads/2024/12/pur_2022_data_summary.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        },
        {
          "url": "https://www.waterboards.ca.gov/drinking_water/certlic/drinkingwater/documents/needs/2025needsassessment.pdf",
          "title": "2025 Drinking Water Needs Assessment",
          "publisher": "State Water Resources Control Board",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260502092945/https://waterboards.ca.gov/drinking_water/certlic/drinkingwater/documents/needs/2025needsassessment.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        },
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billTextClient.xhtml?bill_id=202120220SB1137",
          "title": "SB 1137, Chapter 365, Statutes of 2022",
          "publisher": "California Legislative Counsel",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260902083653/https://leginfo.legislature.ca.gov/faces/billTextClient.xhtml?bill_id=202120220SB1137",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s1",
      "text": "DPR rapporterer at det i 2022 ble brukt 181 millioner pund aktive stoffer i California, og at 92 millioner acre ble behandlet. Begge tallene var lavere enn i 2021.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.cdpr.ca.gov/wp-content/uploads/2024/12/pur_2022_data_summary.pdf",
          "title": "Pesticide Use Annual Report 2022 Data Summary",
          "publisher": "California Department of Pesticide Regulation",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250928034349/https://www.cdpr.ca.gov/wp-content/uploads/2024/12/pur_2022_data_summary.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s2",
      "text": "Fylkestallene for 2022 viser 26 468 541 pund i Fresno, 25 835 076 pund i Kern og 17 537 932 pund i Tulare. Monterey hadde 9 187 117 pund.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.cdpr.ca.gov/wp-content/uploads/2024/12/2022_county_total_pounds_applied_agricultural_applications_and_acres_treated.pdf",
          "title": "Total Pounds, Applications, and Acres Treated by County, 2022",
          "publisher": "California Department of Pesticide Regulation",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250807002358/https://www.cdpr.ca.gov/wp-content/uploads/2024/12/2022_county_total_pounds_applied_agricultural_applications_and_acres_treated.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s3",
      "text": "DPR grupperer blant annet kreftfremkallende stoffer, fumiganter, grunnvannsforurensere og giftige luftforurensere som egne brukskategorier, og publiserer endring fra 2021 til 2022 for hver kategori.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.cdpr.ca.gov/wp-content/uploads/2024/12/pur_2022_data_summary.pdf",
          "title": "Pesticide Use Annual Report 2022 Data Summary",
          "publisher": "California Department of Pesticide Regulation",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250928034349/https://www.cdpr.ca.gov/wp-content/uploads/2024/12/pur_2022_data_summary.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s4",
      "text": "Census tract 6019001000 i Fresno County har pesticidindikator 1 321,97 og persentil 90,83 i CalEnviroScreen 4.0, og 4 255 innbyggere i ACS 2015-2019.",

    },
    {
      "id": "r3-sb1168-lobby",
      "text": "SB 1168 står ikke i WSPA-, Chevron- eller Aera-tekstene fra 2014 som er lest. Den står hos andre filere, blant dem Groundwater Resources Association, filing 1906459, og Planning and Conservation League, filing 1909151, uten at teksten sier posisjon.",
      "status": "confirmed",
      "note": "Fraværet gjelder de leste vedleggene og aktivitetslinjene, ikke alle mulige vedlegg i sesjonen.",
      "sources": [
        {
          "url": "https://campaignfinance.cdn.sos.ca.gov/dbwebexport.zip",
          "title": "CAL-ACCESS raw data export, tables TEXT_MEMO_CD, CVR_LOBBY_DISCLOSURE_CD and LEMP_CD",
          "publisher": "California Secretary of State",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260930110449/https://campaignfinance.cdn.sos.ca.gov/dbwebexport.zip",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s1",
      "text": "SB 1168, kapittel 346, godkjent 16. september 2014. Forfatter på statussiden er Pavley. Loven legger til del 2.74 i Water Code.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billStatusClient.xhtml?bill_id=201320140SB1168",
          "title": "SB 1168 status",
          "publisher": "Legislative Counsel",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250321055920/https://leginfo.legislature.ca.gov/faces/billStatusClient.xhtml?bill_id=201320140SB1168",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s2",
      "text": "Senatet samtykket i forsamlingens endringer 29. august 2014 med 25 mot 10. Forsamlingen vedtok lovforslaget samme dag med 47 mot 27.",
      "status": "confirmed",
      "note": "",
      "sources": [

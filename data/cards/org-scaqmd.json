  "name": "South Coast Air Quality Management District",
  "summary": [
    {
      "id": "s1",
      "text": "Dette er luftkontoret for området rundt Los Angeles. De sier at området ikke klarer grensen for ozon, en gass som irriterer lungene.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.aqmd.gov/docs/default-source/default-document-library/sc-contingency-measures-finalcb7e02f0c2b66f27bf6fff02004a91a9.pdf",
          "title": "South Coast Air Basin Contingency Measure SIP Revision for the 2015 8-Hour Ozone NAAQS",
          "publisher": "South Coast AQMD",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20251111112546/https://www.aqmd.gov/docs/default-source/default-document-library/sc-contingency-measures-finalcb7e02f0c2b66f27bf6fff02004a91a9.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s2",
      "text": "I 2018 sto tunge lastebiler for 27 prosent av NOx, en gass som er med på å lage ozon. Raffinering var blant de største faste kildene, etter fyring i bygninger.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.aqmd.gov/docs/default-source/default-document-library/sc-contingency-measures-finalcb7e02f0c2b66f27bf6fff02004a91a9.pdf",
          "title": "South Coast Air Basin Contingency Measure SIP Revision for the 2015 8-Hour Ozone NAAQS",
          "publisher": "South Coast AQMD",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20251111112546/https://www.aqmd.gov/docs/default-source/default-document-library/sc-contingency-measures-finalcb7e02f0c2b66f27bf6fff02004a91a9.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s3",
      "text": "De har målt utslipp ved seks raffinerier, men kalte anleggene A til F i sammendraget. Vi kan derfor ikke si hvilket tall som hører til hvilket selskap.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.aqmd.gov/docs/default-source/fenceline_monitoring/project_1/fluxsense_scaqmd2015_project1_finalreport(040717).pdf",

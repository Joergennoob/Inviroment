  "summary": [
    {
      "id": "plain-1",
      "text": "Dette er en av tre lover fra 2014 som skulle stanse at vann under bakken tappes for hardt. Roger Dickinson la den fram. Fran Pavley var med og la den fram.",
      "status": "confirmed",
      "note": "",

  ],
  "claims": [
    {
      "id": "c1",
      "text": "UC Davis-rapporten fra 2012, skrevet for State Water Board etter SB X2 1, anslo at om lag 254 000 mennesker i Tulare Lake Basin og Salinas Valley da var i risiko for nitrat i drikkevannet. 220 000 var på offentlige eller state small-systemer, og 34 000 på private brønner.",
      "status": "confirmed",
      "note": "Tallet er fra 2012-studien, ikke fra Failing-listen i 2024.",
      "sources": [
        {
          "url": "https://groundwaternitrate.ucdavis.edu/files/138958.pdf",
          "title": "Addressing Nitrate in California's Drinking Water (2012)",
          "publisher": "UC Davis for the State Water Board",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250115190005/https://groundwaternitrate.ucdavis.edu/files/138958.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "c2",
      "text": "Samme rapport sier at kunstgjødsel og husdyrgjødsel på dyrket mark er de klart største regionale kildene til nitrat i grunnvannet, og at grenseverdien er 45 milligram per liter som nitrat.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://groundwaternitrate.ucdavis.edu/files/138958.pdf",
          "title": "Addressing Nitrate in California's Drinking Water (2012)",
          "publisher": "UC Davis for the State Water Board",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250115190005/https://groundwaternitrate.ucdavis.edu/files/138958.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "c3",
      "text": "Census tract 6019001500 har drikkevannsindikator 1 022,76 og persentil 99,64 i CalEnviroScreen 4.0. Det er ikke et navngitt vannverk.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://services1.arcgis.com/PCHfdHz4GlDNAhBb/arcgis/rest/services/CalEnviroScreen_4_0_Results_/FeatureServer/0/query?where=tract%3D6019001100&outFields=tract,CIscore,CIscoreP,ACS2019TotalPop,pm,drink,pest&returnGeometry=true&outSR=4326&f=geojson",
          "title": "CalEnviroScreen 4.0 FeatureServer, utvalgte trakter",
          "publisher": "OEHHA",
          "retrieved": "2026-10-28",
          "archive_url": "https://web.archive.org/web/20261028154034/https://services1.arcgis.com/PCHfdHz4GlDNAhBb/arcgis/rest/services/CalEnviroScreen_4_0_Results_/FeatureServer/0/query?where=tract%3D6019001100&outFields=tract,CIscore,CIscoreP,ACS2019TotalPop,pm,drink,pest&returnGeometry=true&outSR=4326&f=geojson",
          "archive_note": "Save Page Now 2026-10-28 opprettet et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "c4",
      "text": "SB 200 (Monning, kapittel 120, 2019) opprettet Safe and Affordable Drinking Water Fund. Senatet samtykket 8. juli 2019 med 38 mot 1. Forsamlingen vedtok hasteklausulen 5. juli 2019 med 68 mot 0.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=201920200SB200",
          "title": "SB 200, Chapter 120, Statutes of 2019",
          "publisher": "California Legislative Counsel",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260618041359/https://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=201920200SB200",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        },
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billHistoryClient.xhtml?bill_id=201920200SB200",
          "title": "SB 200 bill history",
          "publisher": "California Legislative Counsel",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260513214152/https://leginfo.legislature.ca.gov/faces/billHistoryClient.xhtml?bill_id=201920200SB200",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "c5",
      "text": "State Water Board skriver i sitt lovhistorikknotat at fondet årlig får fem prosent av Greenhouse Gas Reduction Fund, oppad begrenset til 130 millioner dollar, til 30. juni 2030.",
      "status": "confirmed",
      "note": "Beløpet er hentet fra styrets sammendrag av loven, ikke gjengitt fra selve lovparagrafen i denne runden.",
      "sources": [
        {
          "url": "https://www.waterboards.ca.gov/safer/docs/safer_program_legislative_history.pdf",
          "title": "SAFER Program Legislative History",
          "publisher": "State Water Resources Control Board",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260812021807/https://www.waterboards.ca.gov/safer/docs/safer_program_legislative_history.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    }

  "claims": [
    {
      "id": "c1",
      "text": "Census tract 6025012100 i Imperial County har CalEnviroScreen-score 60,51 og persentil 96,03, med 6 779 innbyggere. PM2.5-indikatoren er 11,85. Trakten er ikke sjøens strandlinje.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://services1.arcgis.com/PCHfdHz4GlDNAhBb/arcgis/rest/services/CalEnviroScreen_4_0_Results_/FeatureServer/0/query?where=tract%3D6019001100&outFields=tract,CIscore,CIscoreP,ACS2019TotalPop,pm,drink,pest&returnGeometry=true&outSR=4326&f=geojson",
          "title": "CalEnviroScreen 4.0 FeatureServer, utvalgte trakter",
          "publisher": "OEHHA",
          "retrieved": "2026-10-28",
          "archive_url": "https://web.archive.org/web/20261028154034/https://services1.arcgis.com/PCHfdHz4GlDNAhBb/arcgis/rest/services/CalEnviroScreen_4_0_Results_/FeatureServer/0/query?where=tract%3D6019001100&outFields=tract,CIscore,CIscoreP,ACS2019TotalPop,pm,drink,pest&returnGeometry=true&outSR=4326&f=geojson",
          "archive_note": "Save Page Now 2026-10-28 opprettet et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "c2",
      "text": "EPA Green Book fører Imperial County som Moderate nonattainment for PM2.5-standarden fra 2012, med 2010-befolkning 154 061 og årsdesignverdi 9,8. Det er et annet tall enn IIDs omtale av PM10.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www3.epa.gov/airquality/greenbook/rncl2.html",
          "title": "PM-2.5 nonattainment areas, Green Book, data current as of September 30, 2026",
          "publisher": "US EPA",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260516043021/https://www3.epa.gov/airquality/greenbook/rncl2.html",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "c3",
      "text": "Problemet rangeres bak pesticider fordi den befolkningen EPA knytter til Imperial i PM2.5-tabellen er langt mindre enn South Coast, San Joaquin Valley og Failing-listen, og fordi playa-arealet i 2025-rapporten ikke er trukket ut.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www3.epa.gov/airquality/greenbook/rncl2.html",
          "title": "PM-2.5 nonattainment areas, Green Book, data current as of September 30, 2026",

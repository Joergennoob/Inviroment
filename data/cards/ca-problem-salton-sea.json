{
  "id": "ca-problem-salton-sea",
  "type": "problem",
  "name": "Salton Sea, eksponert playa og støv",
  "rank": 6,
  "summary": [
    {
      "id": "s1",
      "text": "Imperial Irrigation District skriver at overføringen av inntil om lag 300 000 acre-fot i året med spart vann under Quantification Settlement Agreement reduserer avrenning til Salton Sea, blotlegger playa og kan øke støv.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://saltonseaprogram.com/documents/Salton_Sea_Air_Quality_Mitigation_Program.pdf",
          "title": "Salton Sea Air Quality Mitigation Program",
          "publisher": "Imperial Irrigation District",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20241125104119/https://saltonseaprogram.com/documents/Salton_Sea_Air_Quality_Mitigation_Program.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s2",
      "text": "Samme dokument sier at Imperial County er klassifisert som serious nonattainment for PM10, blant annet på grunn av vindbåret støv, og at fremtidig blotlagt playa ventes å bli en ny støvkilde.",
      "status": "confirmed",
      "note": "Klassifiseringen er gjengitt av IID. Egen oppslag i EPA Green Book for PM10 er ikke gjort i denne runden.",
      "sources": [
        {
          "url": "https://saltonseaprogram.com/documents/Salton_Sea_Air_Quality_Mitigation_Program.pdf",
          "title": "Salton Sea Air Quality Mitigation Program",
          "publisher": "Imperial Irrigation District",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20241125104119/https://saltonseaprogram.com/documents/Salton_Sea_Air_Quality_Mitigation_Program.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s3",
      "text": "CNRAs årsrapport for Salton Sea Management Program fra mars 2025 er skrevet til State Water Board i samsvar med Order WR 2017-0134.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://saltonsea.ca.gov/wp-content/uploads/2025/03/SSMP-2025-Annual-Report_Mar-28.pdf",
          "title": "2025 Annual Report on the Salton Sea Management Program",
          "publisher": "California Natural Resources Agency",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250525074045/https://saltonsea.ca.gov/wp-content/uploads/2025/03/SSMP-2025-Annual-Report_Mar-28.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s4",
      "text": "Imperial Irrigation District, filer 1143378, har 290 134,29 dollar i lobbybetalinger i sesjonen 2025-2026 ifølge Cal-Access.",
      "status": "confirmed",
      "note": "",
      "sources": [

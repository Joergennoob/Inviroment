  "name": "Office of Environmental Health Hazard Assessment",
  "summary": [
    {
      "id": "s1",
      "text": "Dette er Californias miljøhelsekontor. De lager den offisielle oversikten over hvor forurenset og belastet hvert nabolag er. Oversikten heter CalEnviroScreen.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://oehha.ca.gov/calenviroscreen/report/calenviroscreen-40",
          "title": "CalEnviroScreen 4.0",
          "publisher": "OEHHA",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20261019155738/https://oehha.ca.gov/calenviroscreen/report/calenviroscreen-40",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s2",
      "text": "Kartdataene ble hentet 28. oktober 2026. Feltet for opphavsrett er tomt. Områdene er merket med et nummer for hvert nabolag.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://services1.arcgis.com/PCHfdHz4GlDNAhBb/arcgis/rest/services/CalEnviroScreen_4_0_Results_/FeatureServer/0?f=json",
          "title": "CalEnviroScreen 4.0 layer metadata",
          "publisher": "OEHHA",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20261022150903/https://services1.arcgis.com/PCHfdHz4GlDNAhBb/ArcGIS/rest/services/CalEnviroScreen_4_0_Results_/FeatureServer/0?f=json",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s3",
      "text": "Oversikten sammenligner steder. Den måler ikke at en bestemt person er syk. Et høyt tall betyr at nabolaget ligger dårligere an enn de fleste andre.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://oehha.ca.gov/calenviroscreen/report/calenviroscreen-40",
          "title": "CalEnviroScreen 4.0",
          "publisher": "OEHHA",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20261019155738/https://oehha.ca.gov/calenviroscreen/report/calenviroscreen-40",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    }
  ],

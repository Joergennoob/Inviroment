{
  "id": "ca-problem-oil-gas-proximity",
  "type": "problem",
  "name": "Olje og gass nær sensitive reseptorer",
  "rank": 4,
  "summary": [
    {
      "id": "s1",
      "text": "SB 1137, kapittel 365 av 2022, definerer en health protection zone som området innenfor 3 200 fot fra en sensitive receptor, og lovens funn sier at nærhet til utvinning gir helserisiko, særlig fra luftforurensning, og at belastningen uforholdsmessig treffer Black, indigenous and people of color.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billTextClient.xhtml?bill_id=202120220SB1137",
          "title": "SB 1137, Chapter 365, Statutes of 2022",
          "publisher": "California Legislative Counsel",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260902083653/https://leginfo.legislature.ca.gov/faces/billTextClient.xhtml?bill_id=202120220SB1137",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s2",
      "text": "Lovteksten sier at studier har vist skade ved avstander under om lag én kilometer, omtrent 3 200 fot. Den inneholder ikke et folketall.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billTextClient.xhtml?bill_id=202120220SB1137",
          "title": "SB 1137, Chapter 365, Statutes of 2022",
          "publisher": "California Legislative Counsel",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260902083653/https://leginfo.legislature.ca.gov/faces/billTextClient.xhtml?bill_id=202120220SB1137",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s3",
      "text": "CalGEM rapporterer at Kern County produserte 89 661 583 fat olje og kondensat i 2023, og Los Angeles County 8 674 995 fat. Chevron U.S.A. Inc. betalte 20 764 561,84 dollar i vurderinger det året, Aera Energy LLC 17 168 596,04 dollar.",
      "status": "confirmed",
      "note": "Betalingene er assessment payments i årsrapporten, ikke fat og ikke lobbyutgifter.",
      "sources": [
        {
          "url": "https://www.conservation.ca.gov/calgem/Documents/State%20Oil%20and%20Gas%20Supervisor%20Annual%20Report%202023.pdf",
          "title": "Annual Report of the State Oil and Gas Supervisor 2023",
          "publisher": "CalGEM",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20261022212513/https://www.conservation.ca.gov/calgem/Documents/State%20Oil%20and%20Gas%20Supervisor%20Annual%20Report%202023.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s4",
      "text": "CalGEM skriver at loven ble stanset da et referendum kvalifiserte seg i februar 2023, og at den fikk virkning igjen da forslagsstillerne trakk forslaget i juni 2024. Etatssiden sier at loven var fullt iverksatt 28. juni 2024.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.conservation.ca.gov/calgem/Documents/SB%201137%20Initial%20Statement%20of%20Reasons.pdf",
          "title": "SB 1137 Initial Statement of Reasons",
          "publisher": "CalGEM",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20251120154616/https://www.conservation.ca.gov/calgem/Documents/SB%201137%20Initial%20Statement%20of%20Reasons.pdf",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        },
        {
          "url": "https://www.conservation.ca.gov/calgem/Pages/SB1137.aspx",
          "title": "Understanding California's Oil and Gas Safety Zones: Senate Bill 1137",
          "publisher": "CalGEM",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20261019013702/https://www.conservation.ca.gov/calgem/Pages/SB1137.aspx",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    }
  ],

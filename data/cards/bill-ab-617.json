  "type": "bill",
  "name": "AB 617 (2017), samfunnsovervåking av luft",
  "summary": [
    {
      "id": "s1",
      "text": "AB 617, kapittel 136, godkjent 26. juli 2017, forfatter Cristina Garcia. Loven krever utslippsrapportering, en overvåkingsplan og en strategi for samfunn med høy samlet belastning, og gir distriktene hjemmel til å kreve fence-line-måling.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billTextClient.xhtml?bill_id=201720180AB617",
          "title": "AB 617, Chapter 136, Statutes of 2017",
          "publisher": "California Legislative Counsel",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260925233740/https://leginfo.legislature.ca.gov/faces/billTextClient.xhtml?bill_id=201720180AB617",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s2",
      "text": "Forsamlingen samtykket 17. juli 2017 med 50 mot 24. Senatet vedtok samme dag med 27 mot 13.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=201720180AB617",
          "title": "AB 617 bill votes",
          "publisher": "California Legislative Counsel",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20250531134318/https://leginfo.legislature.ca.gov/faces/billVotesClient.xhtml?bill_id=201720180AB617",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s3",
      "text": "Loven gjelder både South Coast og San Joaquin Valley fordi den er statewide og peker på samfunn med høy belastning, ikke ett basseng.",
      "status": "confirmed",
      "note": "",

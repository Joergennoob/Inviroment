{
  "id": "ca-problem-san-joaquin-air",
  "type": "problem",
  "name": "Ozon og PM2.5 i San Joaquin Valley",
  "rank": 2,
  "summary": [
    {
      "id": "s1",
      "text": "EPA fører San Joaquin Valley som Serious nonattainment for PM2.5-standarden fra 2012, med 2010-befolkning 3 842 165 i åtte fylker og årsdesignverdi 13,7 for 2023-2025. Det er høyere enn South Coast sin 13,2 i samme tabell.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www3.epa.gov/airquality/greenbook/rncl2.html",
          "title": "PM-2.5 nonattainment areas, Green Book, data current as of September 30, 2026",
          "publisher": "US EPA",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260516043021/https://www3.epa.gov/airquality/greenbook/rncl2.html",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s2",
      "text": "EPA skrev i 2026 at dalen har de høyeste årlige PM2.5-nivåene i landet, og at området er over 23 000 square miles i åtte fylker, med om lag fire millioner innbyggere og landets ledende jordbruksregion.",
      "status": "confirmed",
      "note": "Fire millioner er EPAs ordlyd i kunngjøringen. Green Book bruker 3 842 165 fra 2010. Begge tallene står, de er ikke regnet om.",
      "sources": [
        {
          "url": "https://www.federalregister.gov/documents/2026/06/11/2026-11735/attainment-date-extension-for-the-san-joaquin-valley-california-2012-annual-pm25-fine-particulate",
          "title": "Attainment Date Extension for the San Joaquin Valley 2012 Annual PM2.5 Area",
          "publisher": "US EPA",
          "retrieved": "2026-10-28",
          "archive_url": "",
          "archive_note": "Wayback availability 2026-10-28 fant ikke et øyeblikksbilde. Save Page Now feilet: TimeoutError."
        }
      ]
    },
    {
      "id": "s3",
      "text": "EPA fastslo at San Joaquin Valley ikke nådde 1997-ozonstandarden innen fristen 15. juni 2024 for et Extreme-område. Vedtaket trådte i kraft 27. oktober 2025.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.federalregister.gov/documents/2025/09/25/2025-18636/finding-of-failure-to-attain-the-1997-8-hour-ozone-standards-california-san-joaquin-valley",
          "title": "Finding of Failure To Attain the 1997 8-Hour Ozone Standards; San Joaquin Valley",
          "publisher": "US EPA",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260317220649/https://www.federalregister.gov/documents/2025/09/25/2025-18636/finding-of-failure-to-attain-the-1997-8-hour-ozone-standards-california-san-joaquin-valley",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s4",
      "text": "Census tract 6019001100 har den høyeste CalEnviroScreen 4.0-scoren i uttrekket, 93,18 og persentil 100, med 2 780 innbyggere i ACS 2015-2019 og PM2.5-indikator 13,91.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://services1.arcgis.com/PCHfdHz4GlDNAhBb/arcgis/rest/services/CalEnviroScreen_4_0_Results_/FeatureServer/0/query?where=tract%3D6019001100&outFields=tract,CIscore,CIscoreP,ACS2019TotalPop,pm,drink,pest&returnGeometry=true&outSR=4326&f=geojson",

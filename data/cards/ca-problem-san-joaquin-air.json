  "claims": [
    {
      "id": "c1",
      "text": "EPA skriver at San Joaquin Valley Unified Air Pollution Control District har hovedansvaret for planene etter delstatslov, og at ansvaret er delt: distriktet vurderer stasjonære kilder og arealkilder, mens CARB vurderer mobile kilder.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.federalregister.gov/documents/2026/06/11/2026-11735/attainment-date-extension-for-the-san-joaquin-valley-california-2012-annual-pm25-fine-particulate",
          "title": "Attainment Date Extension for the San Joaquin Valley 2012 Annual PM2.5 Area",
          "publisher": "US EPA",
          "retrieved": "2026-10-28",
          "archive_url": "",
          "archive_note": "Wayback availability 2026-10-28 fant ikke et øyeblikksbilde. Save Page Now feilet: TimeoutError."
        }
      ]
    },
    {
      "id": "c2",
      "text": "Distriktet vedtok 2024-planen for 2012-PM2.5-standarden 20. juni 2024, og CARB vedtok den 25. juli 2024. Planen ber om å flytte Serious-fristen fra 31. desember 2025 til 31. desember 2030.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www.federalregister.gov/documents/2026/06/11/2026-11735/attainment-date-extension-for-the-san-joaquin-valley-california-2012-annual-pm25-fine-particulate",
          "title": "Attainment Date Extension for the San Joaquin Valley 2012 Annual PM2.5 Area",
          "publisher": "US EPA",
          "retrieved": "2026-10-28",
          "archive_url": "",
          "archive_note": "Wayback availability 2026-10-28 fant ikke et øyeblikksbilde. Save Page Now feilet: TimeoutError."
        }
      ]
    },
    {
      "id": "c3",
      "text": "Green Book fører også dalen som Serious for PM2.5-standardene fra 1997 og 2006, med 24-timers designverdi 42.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www3.epa.gov/airquality/greenbook/rncl2.html",
          "title": "PM-2.5 nonattainment areas, Green Book, data current as of September 30, 2026",
          "publisher": "US EPA",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260516043021/https://www3.epa.gov/airquality/greenbook/rncl2.html",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "c4",
      "text": "Problemet rangeres som nummer to: færre mennesker enn i South Coast, men høyere årsdesignverdi og en EPA-formulering om landets høyeste årlige PM2.5.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://www3.epa.gov/airquality/greenbook/rncl2.html",

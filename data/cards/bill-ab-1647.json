  "name": "AB 1647 (2017), måling ved raffinerier",
  "summary": [
    {
      "id": "s1",
      "text": "Dette er loven som sier at luften skal måles ved gjerdet rundt raffinerier, fabrikker som lager bensin, og at naboene skal kunne se tallene. Den ble vedtatt i 2017. Al Muratsuchi la den fram.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billTextClient.xhtml?bill_id=201720180AB1647",
          "title": "AB 1647, Chapter 589, Statutes of 2017",
          "publisher": "California Legislative Counsel",
          "retrieved": "2026-10-28",
          "archive_url": "http://web.archive.org/web/20260710160257/https://leginfo.legislature.ca.gov/faces/billTextClient.xhtml?bill_id=201720180AB1647",
          "archive_note": "Wayback availability 2026-10-28 fant et øyeblikksbilde."
        }
      ]
    },
    {
      "id": "s2",
      "text": "I delstatsparlamentet stemte forsamlingen 57 mot 19. Senatet stemte 28 mot 11.",
      "status": "confirmed",
      "note": "",
      "sources": [
        {
          "url": "https://leginfo.legislature.ca.gov/faces/billHistoryClient.xhtml?bill_id=201720180AB1647",
          "title": "AB 1647 bill history",
